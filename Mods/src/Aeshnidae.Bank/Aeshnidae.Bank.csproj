<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Aeshnidae.Bank</AssemblyName>
    <RootNamespace>Aeshnidae.Bank</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Already loaded by ACE.Server; Private=False so we share its instance. -->
    <Reference Include="MySqlConnector">
      <HintPath>$(AcePath)\MySqlConnector.dll</HintPath>
      <Private>False</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="Meta.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
