<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared settings (TFM, ACE references, Harmony, output path) come from
    ..\..\Directory.Build.props. Add only mod-specific things here.
  -->

  <PropertyGroup>
    <AssemblyName>Aeshnidae.Fellowship</AssemblyName>
    <RootNamespace>Aeshnidae.Fellowship</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- ModManager refuses to load a folder without Meta.json next to the dll. -->
    <None Update="Meta.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
